database -open waves -into waves.shm -default
probe -create -shm tb_top.apb_vif.monitor_mp.paddr tb_top.apb_vif.monitor_mp.pclk tb_top.apb_vif.monitor_mp.penable tb_top.apb_vif.monitor_mp.prdata tb_top.apb_vif.monitor_mp.pready tb_top.apb_vif.monitor_mp.presetn tb_top.apb_vif.monitor_mp.psel tb_top.apb_vif.monitor_mp.pwdata tb_top.apb_vif.monitor_mp.pwrite
